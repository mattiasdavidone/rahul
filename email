function importContactsInBatches() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const userProps = PropertiesService.getUserProperties();
  

  const savedToken = userProps.getProperty('NEXT_PAGE_TOKEN') || null;


  if (sheet.getLastRow() === 0) {
    sheet.appendRow(["Name", "Email", "Phone"]);
  }

  const existingEmails = new Set();
  const lastRow = sheet.getLastRow();
  if (lastRow > 1) {
    const existingData = sheet.getRange(2, 2, lastRow - 1, 1).getValues();
    existingData.forEach(row => {
      const email = row[0]?.toString().toLowerCase().trim();
      if (email) existingEmails.add(email);
    });
  }
  
// PAGE SIZEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE //
  const response = People.OtherContacts.list({
    readMask: 'names,emailAddresses,phoneNumbers',
    pageSize: 50,
    pageToken: savedToken
  });
// PAGE SIZEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE //

  if (response.otherContacts) {
    const rows = [];
    
    for (const person of response.otherContacts) {
      const name = person.names?.[0]?.displayName || '';
      const rawEmail = person.emailAddresses?.[0]?.value || '';
      const phone = person.phoneNumbers?.[0]?.value || '';
      const normalizedEmail = rawEmail.toLowerCase().trim();
      

      if (normalizedEmail && existingEmails.has(normalizedEmail)) {
        continue;
      }
      
      if (normalizedEmail) existingEmails.add(normalizedEmail);
      rows.push([name, rawEmail, phone]);
    }
    

    if (rows.length > 0) {
      sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, 3).setValues(rows);
    }
  }

  // 4. Save progress bookmark or clear memory if finished
  const nextToken = response.nextPageToken;
  
  if (nextToken) {
    userProps.setProperty('NEXT_PAGE_TOKEN', nextToken);
    SpreadsheetApp.getUi().alert(`Batch of 250 imported! Run again to get the next 250.`);
  } else {

    userProps.deleteProperty('NEXT_PAGE_TOKEN');
    SpreadsheetApp.getUi().alert("All contacts fully imported! Resetting progress bookmark.");
  }
}


function resetProgressToken() {
  PropertiesService.getUserProperties().deleteProperty('NEXT_PAGE_TOKEN');
  SpreadsheetApp.getUi().alert("Progress reset. Next run will start from contact #1.");
}
